# Copy to .env on the VM (never commit .env itself — see apps/README.md).
# chmod 600 it: main is force-mirrored to a public repo on every push, and
# these are the only two lines of edge config that live outside git.
#
# Both are IDENTIFIERS, not secrets — there is no credential in this file.
# Caddy authenticates to Azure DNS as the VM's attached user-assigned managed
# identity (homelab-edge-dns-identity, infra/identity), not a client secret.

AZURE_SUBSCRIPTION_ID=
AZURE_DNS_RESOURCE_GROUP=homelab-rg

# Uncomment only if Caddy logs show it failed to auto-select the managed
# identity (ambiguous only if the VM ever carries more than one — it does
# not today). DefaultAzureCredential honours this for identity selection.
# Do NOT also set AZURE_TENANT_ID alongside it: a partial credential triple
# changes which auth path libdns/azure attempts first.
# AZURE_CLIENT_ID=
