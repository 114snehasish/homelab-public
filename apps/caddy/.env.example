# Copy to .env on the VM (never commit .env itself — see apps/README.md).
# chmod 600 it: main is force-mirrored to a public repo on every push, and
# these are the only two lines of edge config that live outside git.
#
# Both are IDENTIFIERS, not secrets — there is no credential in this file.
# Caddy authenticates to Azure DNS as the VM's one user-assigned managed identity
# (homelab-edge-dns-identity, infra/identity), never a client secret.

AZURE_SUBSCRIPTION_ID=
AZURE_DNS_RESOURCE_GROUP=homelab-rg
